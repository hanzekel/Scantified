generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Camp Model
model Camp {
  id        Int      @id @default(autoincrement())
  name      String   @unique // e.g., "Camp San Pedro", "Camp San Pablo"
  colorCode String? // Optional: Store a hex code for Neo-brutalist UI tags
  members   Member[]
  events    Event[]
  createdAt DateTime @default(now())
}

// 2. Member Model
model Member {
  id           Int                @id @default(autoincrement())
  fullName     String
  campId       Int
  camp         Camp               @relation(fields: [campId], references: [id], onDelete: Cascade)
  role         String             @default("Camper") // Camper, Coordinator, Core Team, Guest
  qrCode       String?            @unique // Optional for backward compatibility with personal QR badges
  phoneNumber  String?            // For lightweight device pairing verification
  pairingToken String?            // Stored device pairing token
  isActive     Boolean            @default(true)
  records      AttendanceRecord[]
  createdAt    DateTime           @default(now())
}

// 3. Event Model
model Event {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  eventType   String         @default("RECURRING") // "MULTI_DAY" or "RECURRING"
  campId      Int?
  camp        Camp?          @relation(fields: [campId], references: [id], onDelete: SetNull)
  schedule    ScheduleRule?
  sessions    EventSession[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

// 4. ScheduleRule Model
model ScheduleRule {
  id         Int      @id @default(autoincrement())
  eventId    Int      @unique
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ruleType   String   // "DATE_RANGE" or "WEEKLY_DAYS"
  startDate  DateTime
  endDate    DateTime
  daysOfWeek String?  // e.g., "FRIDAY,SUNDAY" or "0,5" (0=Sunday..6=Saturday)
  startTime  String?  // e.g., "09:00"
  endTime    String?  // e.g., "11:00"
  createdAt  DateTime @default(now())
}

// 5. EventSession Model
model EventSession {
  id          Int                @id @default(autoincrement())
  eventId     Int?
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String             // e.g., "Day 1 - Morning Plenary", "Friday Service - Oct 24"
  eventDay    Int?               // 1, 2, or 3 (for multi-day events)
  sessionType String             @default("Plenary") // e.g., "Plenary", "Service", "Class"
  date        DateTime           @default(now())
  startTime   DateTime?
  endTime     DateTime?
  status      String             @default("SCHEDULED") // "SCHEDULED", "ACTIVE", "CONCLUDED", "CANCELLED"
  qrSecret    String?            // Secret salt for generating dynamic rotating TOTP tokens
  records     AttendanceRecord[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
}

// 6. AttendanceRecord Model
model AttendanceRecord {
  id        Int      @id @default(autoincrement())
  sessionId Int
  memberId  Int
  status    String   @default("PRESENT") // "PRESENT", "EXCUSED", "ABSENT"
  notes     String?  // Optional explanation for EXCUSED absences
  source    String   @default("SELF_SCAN") // "SELF_SCAN", "MANUAL_OVERRIDE"
  timeIn    DateTime @default(now())

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Critical: A member can only be recorded once per session
  @@unique([sessionId, memberId])
}
